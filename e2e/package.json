{
  "name": "e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "End-to-end Playwright suite for the collaboration-in-local-communities monorepo. Exercises the running backend + frontend against a real Postgres + Cosmos stack.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
